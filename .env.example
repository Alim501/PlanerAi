# Database (Supabase)
# Connection string from: Supabase Dashboard → Project → Settings → Database → Connection string (JDBC)
DB_URL=jdbc:postgresql://db.xxxxxxxxxxxx.supabase.co:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=your_supabase_password

# JWT
JWT_SECRET=your_jwt_secret_here_min_32_chars
ACCESS_TOKEN_EXP=3600000
REFRESH_TOKEN_EXP=604800000

# URLs
FRONT_URL=https://your-frontend-url.railway.app
BACKEND_PUBLIC_URL=https://your-backend-url.railway.app

# AWS S3
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key

# Scheduler (cron expressions for notification jobs)
TASK_DEADLINE_CRON=0 0 9 * * *
PLAN_END_DATE_CRON=0 0 9 * * *

# Mail (Notification-Service)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
